# FlowGen Docker Environment Configuration
# Copy this file to .env before starting Docker Compose (optional)

# Google Gemini API Key (optional - needed for AI code explanations and FlowGen chatbot)
# Get a key from: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Secret key for JWT token encryption
SECRET_KEY=thisissomethinglongandsecret123456

# Database settings
DB_NAME=codeanalyzer
